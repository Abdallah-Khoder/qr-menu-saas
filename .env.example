# Copy this file to .env.local and fill it in. NEVER commit .env.local.
#
# Neon > your project > Connection string.
# Use the DEV branch/project connection string on your computer.
# The PRODUCTION one goes only into the Vercel project settings
# (and into .env.production.local if you use `npm run migrate:prod`).
#
# For `npm run migrate`, prefer Neon's DIRECT connection (turn off the "Pooled connection"
# option in the Connect dialog).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# A long random secret used to sign the login cookie (at least 32 characters).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT value for dev and for production.
SESSION_SECRET=
