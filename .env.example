# Copy this file to .env.local and fill it in. NEVER commit .env.local.
#
# Neon > your project > Connection string.
# Use the DEV branch/project connection string on your computer.
# The PRODUCTION one goes only into the Vercel project settings.
#
# For `npm run migrate`, prefer Neon's DIRECT connection (turn off the "Pooled connection"
# option in the Connect dialog). Migrations are safe through a pooler too, but a direct
# connection is simpler to reason about.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
