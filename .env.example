# Copy this file to .env.local and fill it in. NEVER commit .env.local.
#
# Neon > your project > Connection string.
# Use the DEV branch/project connection string on your computer.
# The PRODUCTION one goes only into the Vercel project settings
# (and into .env.production.local if you use `npm run migrate:prod`).
#
# For `npm run migrate`, prefer Neon's DIRECT connection (turn off the "Pooled connection"
# option in the Connect dialog).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# A long random secret used to sign the login cookie (at least 32 characters).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT value for dev and for production.
SESSION_SECRET=

# Public address of the site, used inside invitation emails.
# On your computer: http://localhost:3000   On Vercel: https://your-project.vercel.app
APP_URL=http://localhost:3000

# Email sending (invitations). Any SMTP service works (Gmail with an app password, Brevo, ...).
# Leave SMTP_HOST empty on your computer: the email is then printed in the terminal instead.
# On the deployed site these are required, otherwise invitations fail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The sender shown to the receiver, e.g.  Menu QR <you@example.com>
EMAIL_FROM=

# Photos of the menu items (Vercel Blob). Vercel dashboard > Storage > your Blob store > the read/write token.
# On your computer it goes into .env.local. On Vercel, connecting the store to the project adds it for you.
BLOB_READ_WRITE_TOKEN=
# Optional: the exact address of your Blob store, e.g. abc123.public.blob.vercel-storage.com. Normally it is worked
# out from the token above; set this only if photos are refused with "الصورة غير صالحة" after a correct upload.
BLOB_PUBLIC_HOST=
